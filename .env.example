# Sift is a hosted web app. Production values live in the Vercel project "sift" (never committed).
# DATABASE_URL=                 # Neon Postgres (set by the Vercel Neon integration). Without it: PGlite in SIFT_DATA_DIR.
# PUBLIK_APP_TOKEN=pat_...      # from POST /api/v1/apps/sift/token after the listing is published
# PUBLIK_CREDITS_KEY=pk_...     # the developer's publik key: fellowship credits pay every user's AI calls
# COMPOSIO_API_KEY=             # Gmail / Outlook / Slack through Composio, server side only
# APP_SECRET=                   # 32+ random characters: encrypts each session's publik key

# Local tests against the mocks (scripts/mock-publik.mjs, scripts/mock-connector.mjs)
# PUBLIK_ORIGIN=http://localhost:4555
# PUBLIK_APP_TOKEN=pat_mocktoken
# CONNECTOR_ORIGIN=http://localhost:4666
# SIFT_DATA_DIR=/tmp/sift
